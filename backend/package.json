{
  "name": "kaoyan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "考研复习 App 后端（NestJS + PostgreSQL 17）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node dist/src/main.js",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "migrate": "tsc -p tsconfig.json && node dist/scripts/migrate.js",
    "migrate:dates": "tsc -p tsconfig.json && node dist/scripts/migrate-dates.js",
    "import:2024": "tsc -p tsconfig.json && node dist/scripts/import-questions.js --tree ../tiku/knowledge_tree.json --questions ../tiku/math1_2024.json --report import_report_2024.md",
    "mock": "node mock/server.js",
    "test:smoke": "bash scripts/smoke.sh",
    "test:smoke:offline": "bash scripts/smoke-offline.sh",
    "seed:words": "tsc -p tsconfig.json && node dist/scripts/seed-words.js",
    "db:init": "bash scripts/db.sh init",
    "db:reset": "bash scripts/db.sh psql -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"",
    "setup": "npm run db:init && npm run migrate && npm run import:2024 && npm run seed:words",
    "import:all": "node dist/scripts/import-questions.js --tree ../tiku/knowledge_tree.json --questions ../tiku --report-dir import_reports && node dist/scripts/import-vocab.js",
    "import:vocab": "tsc -p tsconfig.json && node dist/scripts/import-vocab.js",
    "ai:check": "tsc -p tsconfig.json && node dist/scripts/ai-check.js",
    "key:preflight": "bash scripts/key-preflight.sh",
    "ai:explain": "tsc -p tsconfig.json && node dist/scripts/ai-explain.js",
    "gen:explanations": "tsc -p tsconfig.json && node dist/scripts/gen-explanations.js",
    "import:words": "tsc -p tsconfig.json && node dist/scripts/import-words.js",
    "fake-llm": "node test/fake-llm.js",
    "test:tools": "tsc -p tsconfig.json && node dist/scripts/test-agent-tools.js",
    "test:sources": "bash scripts/test-sources.sh",
    "audio:prefetch": "tsc -p tsconfig.json && node dist/scripts/audio-prefetch.js",
    "watch:tiku": "node scripts/watch-tiku.js",
    "test:unit": "tsc -p tsconfig.json && node dist/scripts/test-unit.js",
    "test:offline": "tsc -p tsconfig.json && node dist/scripts/test-offline.js",
    "eval:agent": "tsc -p tsconfig.json && node dist/scripts/eval-agent.js",
    "test:english1": "bash scripts/test-english1.sh",
    "eval:grading": "tsc -p tsconfig.json && node dist/scripts/eval-grading.js",
    "bench:pdf": "bash scripts/bench-pdf.sh"
  },
  "dependencies": {
    "@mastra/core": "^1.81.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "cron": "^4.4.0",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^24.43.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
