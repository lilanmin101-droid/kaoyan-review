DATABASE_URL=postgres://kaoyan:kaoyan@127.0.0.1:5432/kaoyan
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# ---- AI（没有 Key 时全部走模拟数据，接口形状不变）----
# DeepSeek（主模型：Agent 工具调用 + 讲解生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-07-24 起 deepseek-chat / deepseek-reasoner 已下线；填旧名会自动映射到 deepseek-flash（chat=关思考，reasoner=开思考）
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-flash
# 通义千问 DashScope 兼容模式（交叉验证模型）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
# 强制模拟模式（有 Key 也不调用）：AI_MOCK=1
AI_MOCK=
# 讲解：讲解接口没有预生成讲解时现场生成一次（两个 Key 都在才会；0 = 关闭）
EXPLAIN_ON_DEMAND=
# npm run gen:explanations --dry-run 的估价单价（美元 / 百万 token；不填用 2026-11 官网价：deepseek-flash 高峰 0.30/1.20、低峰 0.15/0.60，qwen-max 北京 0.345/1.377）
# DEEPSEEK_PRICE_IN= DEEPSEEK_PRICE_OUT= DEEPSEEK_PRICE_IN_OFFPEAK= DEEPSEEK_PRICE_OUT_OFFPEAK= QWEN_PRICE_IN= QWEN_PRICE_OUT=
# 单次模型调用超时（毫秒）
AI_TIMEOUT_MS=120000

# ---- 时区与定时任务 ----
# 「今天」和定时任务都按这个时区算
APP_TZ=Asia/Shanghai
# 定时任务开关（23:00 复盘 / 周日周报 / 每日阶段检查）；设成 0 关闭
JOBS_ENABLED=1

# 题目图片目录（题目 JSON 所在目录）
ASSETS_DIR=/workspace/kaoyan/tiku
# EXPLANATIONS_DIR=/workspace/kaoyan/tiku/explanations   # 行业专家讲解 *_expert.jsonl
