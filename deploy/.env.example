# 考研复习 App · 部署配置（复制成 .env 再改；.env 不要提交、不要发群里）
# server-up.sh 第一次运行时如果没有 .env，会从这里复制一份并自动生成随机的 POSTGRES_PASSWORD / JWT_SECRET

# ---- 访问方式 ----
# 有域名就填（A 记录先指向服务器 IP），Caddy 会自动申请 HTTPS 证书；留空则用 http://服务器IP
# 注意：手机浏览器的麦克风（费曼「讲给它听」）和「添加到主屏幕」只在 HTTPS 下可用
DOMAIN=
# 宿主机端口（一般不用改；80/443 被占时可改，但自动 HTTPS 需要 80 和 443）
HTTP_PORT=80
HTTPS_PORT=443

# ---- 数据库 ----
# 只用字母数字（会拼进连接串）；openssl rand -hex 24
POSTGRES_PASSWORD=
# DATABASE_URL 由 docker-compose 自动拼成 postgres://kaoyan:<密码>@db:5432/kaoyan，不用填

# ---- 登录 ----
# 长随机串；openssl rand -hex 32。改了以后所有人要重新登录
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ---- AI（没有 Key 时全部走模拟数据，接口形状不变）----
# DeepSeek（主模型：Agent 工具调用 + 讲解生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-07-24 起 deepseek-chat / deepseek-reasoner 已下线；填旧名会自动映射到 deepseek-flash（chat=关思考，reasoner=开思考）
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-flash
# 通义千问 DashScope 兼容模式（交叉验证模型）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
# 强制模拟模式（有 Key 也不调用）：AI_MOCK=1
AI_MOCK=
# 讲解：讲解接口没有预生成讲解时现场生成一次（两个 Key 都在才会；0 = 关闭）
EXPLAIN_ON_DEMAND=
# npm run gen:explanations --dry-run 的估价单价（美元 / 百万 token；不填用 2026-11 官网价：deepseek-flash 高峰 0.30/1.20、低峰 0.15/0.60，qwen-max 北京 0.345/1.377）
# DEEPSEEK_PRICE_IN= DEEPSEEK_PRICE_OUT= DEEPSEEK_PRICE_IN_OFFPEAK= DEEPSEEK_PRICE_OUT_OFFPEAK= QWEN_PRICE_IN= QWEN_PRICE_OUT=
# 单次模型调用超时（毫秒）
AI_TIMEOUT_MS=120000
# Agent 单次对话最多调用工具几步
AGENT_MAX_STEPS=10

# ---- 时区与定时任务 ----
# 「今天」和定时任务都按这个时区算
APP_TZ=Asia/Shanghai
# 定时任务开关（23:00 复盘 / 周日周报 / 每日阶段检查）；设成 0 关闭
JOBS_ENABLED=1
# 自定义 cron（秒 分 时 日 月 周），留空用默认
JOB_NIGHTLY_CRON=
JOB_WEEKLY_CRON=
JOB_PHASE_CRON=
JOB_MIDDAY_CRON=
# 距考试多少天进入冲刺 / 强化阶段
PHASE_SPRINT_DAYS=30
PHASE_INTENSIVE_DAYS=180

# ---- 部署脚本用 ----
# 构建镜像时的 npm 源；国内服务器建议 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
# 每次部署是否重新导入 ECDICT 单词（upsert，不会覆盖真题例句/频次）；设成 0 跳过
IMPORT_WORDS=1
# 前端镜像怎么构建：
#   deploy/web.Dockerfile           服务器上 npm ci + vite build（默认）
#   deploy/web.prebuilt.Dockerfile  直接用开发机 build 好、deploy.sh 同步过去的 frontend/dist（推荐小内存机器）
WEB_DOCKERFILE=deploy/web.Dockerfile

# ---- 备份（docker-compose 里的 backup 服务，不用宿主机 cron）----
# 每天几点备份（APP_TZ 时区，HH:MM）
BACKUP_AT=03:15
# 备份保留几天（deploy/backups/ 下 kaoyan-*.dump 和 uploads-*.tar.gz）
BACKUP_KEEP_DAYS=7
# 手动 backup.sh 保留份数
BACKUP_KEEP=7

# ---- 生产开关（docker-compose.yml 里已强制，写在这里只是说明，改这里不生效）----
# NODE_ENV=production   DEV_TOOLS=0（POST /agent/jobs/run 返回 404）   DISABLE_DEBUG_NOW=1（不认 X-Debug-Now）   AI_FAKE=（空）

# 以下路径在 docker-compose.yml 里固定为容器内路径，无需设置：
# ASSETS_DIR=TIKU_DIR=/data/tiku  EXPLANATIONS_DIR=/data/tiku/explanations  REVIEWS_DIR=/data/tiku/reviews
# ECDICT_PATH=ECDICT_CSV=/data/ecdict/ecdict.csv  AUDIO_DIR=/app/audio  CHROME_PATH=/usr/bin/chromium  PORT=3000
# 题库 / ECDICT 不在默认位置（../tiku、../data/ecdict）时可改宿主机目录：
# TIKU_HOST_DIR=../tiku
# ECDICT_HOST_DIR=../data/ecdict
